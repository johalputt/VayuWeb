{
  "name": "@vayuweb/registry",
  "version": "0.2.0",
  "private": true,
  "description": "VayuWeb name registry: signed append-only log, deterministic CBOR, Ed25519, Argon2id proof-of-work",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test --experimental-strip-types 'src/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "vectors": "node --experimental-strip-types scripts/generate-vectors.ts"
  },
  "dependencies": {
    "@helia/unixfs": "^8.0.5",
    "@noble/curves": "^1.6.0",
    "@noble/hashes": "^1.5.0",
    "blockstore-fs": "^4.0.1",
    "datastore-fs": "^12.0.1",
    "helia": "^7.1.3",
    "hyperswarm": "^4.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "bin": {
    "vayuweb-registry": "bin/vayuweb-registry.ts"
  }
}
